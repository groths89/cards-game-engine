# Your actual AWS credentials (replace with your own)
export AWS_ACCESS_KEY_ID="AKIA..."
export AWS_SECRET_ACCESS_KEY="your_secret_access_key"
export AWS_DEFAULT_REGION="us-east-1" # Or your actual region

# Your application-specific variables (from your App Runner config)
export APP_SYNC_API_KEY="your_appsync_key"
export APP_SYNC_API_URL="your_appsync_url"
export COGNITO_APP_CLIENT_ID="your_cognito_app_client_id"
export COGNITO_IDENTITY_POOL_ID="your_cognito_identity_pool_id"
export COGNITO_REGION="us-east-1"
export COGNITO_USER_POOL_ID="your_cognito_user_pool_id"
export DYNAMODB_REGION="us-east-1"
export DYNAMODB_TABLE_PREFIX="your_table_prefix"
export FLASK_SECRET_KEY="a_secure_random_string"

# IMPORTANT: Use your *actual* DynamoDB table names, without the -NONE suffix
export GAME_HISTORY_TABLE="YourActualGameHistoryTableName"
export USERS_TABLE="YourActualUsersTableName"

export ENVIRONMENT="development" # or "production"
export PORT=8080 # Gunicorn will listen on this port